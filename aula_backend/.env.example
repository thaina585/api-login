# Copie para ".env" e preencha. O ".env" nunca vai para o GitHub.

# Endereço do banco PostgreSQL. Para rodar fora do Render, use a
# "External Database URL" do banco (painel do banco > Connect > External).
DATABASE_URL=postgresql://usuario:senha@endereco.oregon-postgres.render.com/banco

# Frase secreta para assinar os tokens de login. Longa e difícil de adivinhar.
JWT_SEGREDO=troque-por-uma-frase-longa-e-dificil-de-adivinhar

PORT=3000
